---
import SiteLayout from "./SiteLayout.astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import WindowBar from "../components/WindowBar.astro";
import { SITE_TITLE } from "../consts";
import { ABOUT } from "../data/profile";
interface Sibling {
  id: string;
  title: string;
}
type Props = CollectionEntry<"blog">["data"] & {
  prev?: Sibling;
  next?: Sibling;
};
const { title, description, pubDate, updatedDate, heroImageUrl, prev, next } =
  Astro.props;
---

<SiteLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  image={heroImageUrl}
  imageAlt={title}
  article={{ title, published: pubDate, modified: updatedDate }}
>
  <main id="main" class="site-width article-main">
    <a class="text-link back-link" href="/blog/" data-track-event="article_link_click" data-track-location="article-navigation" data-track-id="back-to-blog">
      ← All posts
    </a>
    <article class="window">
      <WindowBar>
        <span>▤ &nbsp; from-the-keyboard.md</span>
      </WindowBar>
      <header class="article-header" data-reveal>
        <div class="article-date">
          <a href="/about/" rel="author" data-track-event="article_link_click" data-track-location="article-header" data-track-id="author">
            {ABOUT.name}
          </a>
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span>
              {" "}
              / Updated <FormattedDate date={updatedDate} />
            </span>
          )}
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <div class="prose" data-track-article data-track-location="article-body">
        <slot />
      </div>
      <footer class="article-footer">
        <p class="article-sign">
          Thanks for reading. Questions or corrections are welcome &mdash;
          <a href="/contact/" data-track-event="cta_click" data-track-location="article-footer" data-track-id="contact">write to me</a>.
        </p>
        <nav class="article-nav" aria-label="More posts">
          {next && (
            <a class="article-nav-link" href={`/blog/${next.id}/`} data-track-event="article_link_click" data-track-location="article-footer" data-track-id={`next-${next.id}`}>
              <span class="eyebrow">Newer post</span>
              <span class="article-nav-title">{next.title}</span>
            </a>
          )}
          {prev && (
            <a class="article-nav-link article-nav-link--prev" href={`/blog/${prev.id}/`} data-track-event="article_link_click" data-track-location="article-footer" data-track-id={`prev-${prev.id}`}>
              <span class="eyebrow">Older post</span>
              <span class="article-nav-title">{prev.title}</span>
            </a>
          )}
        </nav>
      </footer>
    </article>
  </main>
</SiteLayout>

<style>
  .article-main {
    max-width: 700px;
    padding-top: 36px;
  }
  .article-header {
    border-bottom: 1px solid var(--line);
    padding: 32px;
  }
  .article-header h1 {
    font-size: clamp(34px, 4.6vw, 52px);
    margin: 20px 0;
  }
  .article-header p {
    color: var(--muted);
    font-size: 14px;
  }
  .article-date {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .prose {
    padding: 32px;
    font-size: 14px;
    line-height: 1.95;
    overflow-wrap: break-word;
  }
  .prose :global(a) {
    text-decoration-color: var(--line);
  }
  .prose :global(a:is(:hover, :focus-visible)) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .prose :global(p) {
    margin-bottom: 24px;
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-mono);
    font-size: 21px;
    line-height: 1.4;
    margin: 36px 0 18px;
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    margin: 15px 0 30px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 20px 0;
    padding-left: 25px;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    background: var(--blue);
    padding: 2px 4px;
    font-size: 0.9em;
  }
  .prose :global(pre) {
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--line);
    margin: 25px 0;
  }
  .prose :global(pre code) {
    padding: 0;
    background: transparent;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 5px 20px;
    margin: 25px 0;
  }
  .article-footer {
    border-top: 1px solid var(--line);
  }
  .article-sign {
    padding: 20px 32px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .article-sign a {
    font-weight: 700;
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .article-sign a:is(:hover, :focus-visible) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .article-nav:has(.article-nav-link:only-child) {
    grid-template-columns: minmax(0, 1fr);
  }
  .article-nav-link {
    display: grid;
    gap: 7px;
    padding: 18px 32px 22px;
    text-decoration: none;
    transition: background 0.18s;
  }
  .article-nav-link + .article-nav-link {
    border-left: 1px solid var(--line);
  }
  .article-nav-link:is(:hover, :focus-visible) {
    background: var(--blue);
  }
  .article-nav-link:focus-visible {
    outline-offset: -3px;
  }
  .article-nav-link--prev:not(:only-child) {
    text-align: right;
  }
  .article-nav-link--prev:not(:only-child) .eyebrow {
    justify-content: flex-end;
  }
  .article-nav-title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
  }
  .back-link {
    margin-bottom: 24px;
  }
  @media (max-width: 600px) {
    .article-header,
    .prose {
      padding: 24px 20px;
    }
    .article-header h1 {
      font-size: 46px;
    }
    .prose {
      font-size: 13px;
    }
    .article-date {
      font-size: 11px;
    }
    .article-sign {
      padding: 18px 20px;
    }
    .article-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-nav-link {
      padding: 16px 20px;
    }
    .article-nav-link + .article-nav-link {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .article-nav-link--prev:not(:only-child) {
      text-align: left;
    }
    .article-nav-link--prev:not(:only-child) .eyebrow {
      justify-content: flex-start;
    }
  }
</style>
