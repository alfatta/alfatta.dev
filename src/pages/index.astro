---
import Hero from "../components/home/Hero.astro";
import AboutPreview from "../components/home/AboutPreview.astro";
import CoffeePreview from "../components/home/CoffeePreview.astro";
import ExperiencePreview from "../components/home/ExperiencePreview.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactBanner from "../components/ContactBanner.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION } from "../consts";
import { featuredProject } from "../data/profile";
import {
  currentExperience,
  engineeringExperiences,
  getRecentCompanies,
} from "../data/experience";
import { getCoffeeSummary } from "../data/coffee";
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const recentCompanies = getRecentCompanies(engineeringExperiences);
const coffee = getCoffeeSummary();
---

<SiteLayout
  title="Alfatta Rezqa — Frontend & Software Developer"
  description={SITE_DESCRIPTION}
>
  <main id="main" class="site-width">
    <Hero company={currentExperience?.company} />
    <section class="section" id="work" aria-labelledby="work-title">
      <div class="section-title" data-reveal>
        <div>
          <h2 id="work-title">Featured work</h2>
        </div>
      </div>
      <ProjectCard project={featuredProject} />
    </section>
    <ExperiencePreview experiences={recentCompanies} />
    <section class="section" aria-labelledby="notes-title">
      <div class="section-title" data-reveal>
        <div>
          <h2 id="notes-title">Writing</h2>
        </div>
        <a class="text-link" href="/blog/" data-track-event="cta_click" data-track-location="recent-posts" data-track-id="all-posts">
          All posts <span>→</span>
        </a>
      </div>
      <div class="post-grid">
        {posts.map((post, index) => (
          <PostCard post={post} index={index} />
        ))}
      </div>
    </section>
    <CoffeePreview summary={coffee} />
    <AboutPreview />
    <ContactBanner />
  </main>
</SiteLayout>
