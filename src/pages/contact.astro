---
import SiteLayout from "../layouts/SiteLayout.astro";
import PixelIcon from "../components/PixelIcon.astro";
import WindowBar from "../components/WindowBar.astro";
import { SITE_TITLE } from "../consts";
import { ABOUT, emailContact, socialLinks } from "../data/profile";
---

<SiteLayout
  title={`Contact Alfatta Rezqa | ${SITE_TITLE}`}
  description="Get in touch with Alfatta Rezqa by email, or connect on LinkedIn, GitHub, Instagram, and X. Let's talk about software, ideas, and collaboration."
>
  <main id="main" class="site-width page-main contact-page">
    <header class="page-heading" data-reveal>
      <h1>Let's talk<span aria-hidden="true">.</span></h1>
      <p>
        Have a project in mind, a question about my work, or just want to talk
        tech? Here's where you can find me.
      </p>
    </header>

    <div class="contact-grid">
      <section class="window email-window" aria-labelledby="email-title" data-reveal>
        <WindowBar>
          <h2 id="email-title">Send a hello</h2>
          <span slot="trailing" aria-hidden="true">hello.mail</span>
        </WindowBar>
        <div class="window-content email-content" data-track-location="contact-email">
          <PixelIcon name="mail" class="contact-icon" />
          <div class="contact-identity">
            <p class="contact-name">{ABOUT.name}</p>
            <p>{ABOUT.jobTitle}</p>
          </div>
          <p class="email-intro">
            Good things start with a hello. Drop me an email and let's take it
            from there.
          </p>
          <a class="email-address" href={emailContact.href} data-track-event="email_click" data-track-id="email-address">{emailContact.handle}</a>
          <a class="button primary" href={emailContact.href} data-track-event="email_click" data-track-id="write-email">
            Write an email <span aria-hidden="true">↗</span>
          </a>
          <p class="email-note">Opens your email app. No forms, just a conversation.</p>
        </div>
      </section>

      <section class="window social-window" aria-labelledby="social-title" data-reveal>
        <WindowBar>
          <h2 id="social-title">Around the internet</h2>
          <span slot="trailing" aria-hidden="true">social.links</span>
        </WindowBar>
        <div class="window-content social-intro-row" data-track-location="contact-social">
          <p class="social-intro">Connect, follow along, or see what I'm working on.</p>
        </div>
        <ul class="social-list" data-track-location="contact-social">
          {socialLinks.map((contact) => (
            <li>
              <a class="social-link" href={contact.href} target="_blank" rel="noreferrer"
                data-track-event="social_click" data-track-id={contact.id} data-track-platform={contact.id}>
                <span class="social-heading">
                  <h3>{contact.label}</h3>
                  <span class="social-handle">@{contact.handle}</span>
                </span>
                <p>{contact.description}</p>
                <span class="social-arrow" aria-hidden="true">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="contact-signoff" data-reveal>
      <PixelIcon name="monitor" class="signoff-icon" />
      <p>Until then, see you around the internet.</p>
      <a class="text-link" href="/about/" data-track-event="cta_click" data-track-location="contact-signoff" data-track-id="about-me">A little about me <span aria-hidden="true">→</span></a>
    </div>
  </main>
</SiteLayout>

<style>
  .contact-page {
    padding-bottom: 28px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 18px;
  }
  .email-window {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .email-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    height: 100%;
    gap: 14px;
  }
  .contact-icon {
    width: 72px;
    height: 72px;
  }
  .contact-identity {
    color: var(--muted);
    font-size: 12px;
  }
  .contact-name {
    color: var(--ink);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 3px;
  }
  .email-intro,
  .social-intro {
    color: var(--muted);
    font-size: 12px;
  }
  .email-address {
    font-size: clamp(16px, 2vw, 21px);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .email-address:hover {
    color: var(--accent);
  }
  .email-note {
    font-size: 11px;
    color: var(--muted);
  }
  .social-intro-row {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .social-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social-list li + li .social-link {
    border-top: 1px solid var(--line);
  }
  .social-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 16px;
    padding: 15px 22px;
    text-decoration: none;
    transition: background 0.18s;
  }
  .social-link:is(:hover, :focus-visible) {
    background: var(--blue);
  }
  .social-link:focus-visible {
    outline-offset: -3px;
  }
  .social-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .social-heading h3 {
    font-size: 16px;
  }
  .social-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    transition: transform 0.18s ease-out;
  }
  .social-link:is(:hover, :focus-visible) .social-arrow {
    transform: translate(2px, -2px);
  }
  .social-handle {
    font-size: 12px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .social-link p {
    grid-column: 1;
    font-size: 11px;
    color: var(--muted);
  }
  .contact-signoff {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
    padding: 16px 0;
    color: var(--muted);
    font-size: 12px;
  }
  .signoff-icon {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .contact-signoff .text-link {
    margin-left: auto;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .social-intro-row {
      padding-bottom: 16px;
    }
    .social-link {
      padding: 14px 18px;
    }
    .contact-signoff .text-link {
      margin-left: 0;
    }
  }
</style>
