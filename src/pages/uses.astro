---
import SiteLayout from "../layouts/SiteLayout.astro";
import PixelIcon from "../components/PixelIcon.astro";
import UsesDeviceArt from "../components/UsesDeviceArt.astro";
import { SITE_TITLE } from "../consts";

const gear = [
  { device: "laptop", role: "Laptop", name: "MacBook Air M5", href: "https://s.shopee.co.id/4fxvlL8soT", specs: ["16 GB unified memory", "512 GB SSD", "10-core CPU", "8-core GPU", "Liquid Retina · 2560 × 1664"] },
  { device: "phone", role: "Phone", name: "Samsung Galaxy S25 FE", href: "https://s.shopee.co.id/6L69kQkXmj", specs: ["8 GB RAM", "256 GB storage", "One UI 9 · Android 17"] },
  { device: "earbuds", role: "Earbuds", name: "Soundcore R50i", href: "https://s.shopee.co.id/6fj097mLI6", specs: ["10 mm drivers", "Bluetooth 5.3", "IPX5", "Up to 30 h with case"] },
  { device: "camera", role: "Camera", name: "Fujifilm X-A7", href: "https://s.shopee.co.id/7VI78cbJeD", specs: ["24.2 MP APS-C", "X mount", "4K / 30 fps", "3.5-inch flip screen"] },
] as const;

const tools = [
  { icon: "code", role: "Editor", links: [["Zed", "https://zed.dev/"]] },
  { icon: "monitor", role: "Terminal", links: [["Ghostty", "https://ghostty.org/"]] },
  { icon: "chip", role: "Coding harness", links: [["omp", "https://omp.sh/"]] },
  { icon: "robot", role: "AI assistants", links: [
    ["Codex", "https://openai.com/codex/"],
    ["Claude", "https://www.anthropic.com/claude-code"],
  ] },
] as const;
---

<SiteLayout
  title={`Uses — Alfatta Rezqa | ${SITE_TITLE}`}
  description="Alfatta Rezqa’s daily setup: MacBook Air M5, Galaxy S25 FE, Soundcore R50i, Fujifilm X-A7, and the tools he uses to write code."
>
  <main id="main" class="site-width page-main uses-page">
    <header class="page-heading" data-reveal>
      <span class="label">Daily driver</span>
      <h1>What I use.</h1>
      <p>The gear I carry and the tools I reach for when I'm writing code.</p>
    </header>

    <section aria-labelledby="gear-title">
      <div class="section-title" data-reveal>
        <div>
          <span class="eyebrow">01 / Hardware</span>
          <h2 id="gear-title">Daily carry</h2>
        </div>
      </div>
      <ul class="gear-grid">
        {gear.map(({ device, role, name, href, specs }) => (
          <li class:list={["window", "device", `device--${device}`]} data-reveal>
            <div class="device-art">
              <UsesDeviceArt device={device} />
            </div>
            <div class="device-copy">
              <span class="eyebrow">{role}</span>
              <h3><a class="software-link" href={href} rel="sponsored">{name}<span aria-hidden="true"> ↗</span></a></h3>
              {specs.length > 0 && (
                <ul class="device-specs" aria-label={`${name} specifications`}>
                  {specs.map((spec) => <li>{spec}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p><small>The Shopee links above are affiliate links. I may earn a commission if you buy through them.</small></p>
    </section>

    <section class="section" aria-labelledby="tools-title">
      <div class="section-title" data-reveal>
        <div>
          <span class="eyebrow">02 / Software</span>
          <h2 id="tools-title">The dev desk</h2>
        </div>
      </div>
      <div class="desk-grid">
        <ul class="tool-dock">
          {tools.map(({ icon, role, links }) => (
            <li class="window tool" data-reveal>
              <span class="tool-icon"><PixelIcon name={icon} /></span>
              <span class="eyebrow">{role}</span>
              <h3>
                {links.map(([name, href], index) => (
                  <>{index > 0 && " + "}<a class="software-link" href={href}>{name}<span aria-hidden="true"> ↗</span></a></>
                ))}
              </h3>
            </li>
          ))}
        </ul>
        <div class="window font-card" data-reveal>
          <div class="font-specimen" aria-hidden="true">Aa <span>{'{ }'}</span> 01</div>
          <div class="device-copy">
            <span class="eyebrow">Favorite font</span>
            <h3><a class="software-link" href="https://github.com/subframe7536/Maple-font">Maple Mono<span aria-hidden="true"> ↗</span></a></h3>
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .uses-page {
    padding-bottom: clamp(30px, 5vw, 60px);
  }
  .gear-grid,
  .tool-dock {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gear-grid {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-rows: repeat(3, auto);
  }
  .device {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
  }
  .device--laptop {
    grid-row: 1 / -1;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
  }
  .device-art {
    display: grid;
    place-items: center;
    min-height: 122px;
    border-right: 1px solid var(--line);
    background-color: var(--device-surface, var(--blue));
    background-image: radial-gradient(var(--line) 0.7px, transparent 0.7px);
    background-size: 10px 10px;
    padding: 10px;
  }
  .device-art :global(svg) {
    display: block;
    width: min(100%, 190px);
    color: var(--ink);
  }
  .device--laptop .device-art {
    border-right: 0;
    border-bottom: 1px solid var(--line);
    min-height: 218px;
  }
  .device--laptop .device-art :global(svg) {
    width: min(82%, 340px);
  }
  .device--phone {
    --device-surface: color-mix(in srgb, var(--surface) 75%, #84a68e);
  }
  .device--earbuds {
    --device-surface: color-mix(in srgb, var(--surface) 75%, #c2a275);
  }
  .device-copy {
    align-self: center;
    padding: 18px;
  }
  .device-copy .eyebrow,
  .tool .eyebrow {
    margin-bottom: 6px;
  }
  .device-copy h3,
  .tool h3 {
    font-size: 17px;
    line-height: 1.25;
  }
  .device--laptop h3 {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 400;
  }
  .desk-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: 16px;
  }
  .tool-dock {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .tool {
    padding: 14px;
  }
  .tool-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 14px;
    border: 1px solid var(--line);
    background: var(--blue);
  }
  .tool-icon :global(svg) {
    width: 29px;
  }
  .font-card {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .font-specimen {
    align-content: center;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--blue);
    font-size: clamp(22px, 3.5vw, 44px);
    font-weight: 700;
    line-height: 1.25;
  }
  .font-specimen span {
    color: var(--accent);
  }
  .software-link {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .software-link:is(:hover, :focus-visible) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .device-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .device-specs li {
    padding: 2px 7px;
    border: 1px solid var(--line);
    background: var(--blue);
    font-size: 11px;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .device-art :global(svg) {
      transition: transform 220ms ease-out;
    }
    .device:hover .device-art :global(svg) {
      transform: translateY(-5px);
    }
  }
  @media (max-width: 900px) {
    .tool-dock {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .gear-grid,
    .desk-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .gear-grid {
      grid-template-rows: auto;
    }
    .device--laptop {
      grid-row: auto;
    }
    .device--laptop .device-art {
      min-height: 0;
    }
  }
</style>