---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import ContactBanner from "../../components/ContactBanner.astro";
import { SITE_TITLE } from "../../consts";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title={`Frontend Development Blog | ${SITE_TITLE}`}
  description="Practical notes by Alfatta Rezqa on Vue 3 reactivity, Cloudflare redirects, and setting up a Linux development environment."
>
  <main id="main" class="site-width page-main">
    <header class="page-heading" data-reveal>
      <h1>Writing.</h1>
      <p>
        Notes on frontend development, Vue, and the tools I use to build
        software.
      </p>
      <a class="text-link" href="/rss.xml" data-track-event="rss_click" data-track-location="blog-list" data-track-id="rss">
        RSS feed ↗
      </a>
    </header>
    <div class="post-grid blog-list">
      {posts.map((post, index) => (
        <PostCard
          post={post}
          index={index}
          variant={index === 0 ? "featured" : "detailed"}
          headingLevel="h2"
        />
      ))}
    </div>
    <ContactBanner />
  </main>
</SiteLayout>

<style>
  .blog-list {
    grid-template-columns: repeat(2, 1fr);
  }
  .blog-list > :global(:first-child) {
    grid-column: 1 / -1;
  }
  .blog-list :global(.post-card) {
    min-width: 0;
  }
  .page-heading .text-link {
    margin-top: 16px;
  }
  @media (max-width: 600px) {
    .blog-list {
      grid-template-columns: 1fr;
    }
  }
</style>
