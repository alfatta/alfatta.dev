---
import SiteLayout from "../layouts/SiteLayout.astro";
import PixRelayVisual from "../components/PixRelayVisual.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PixelIcon from "../components/PixelIcon.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ContactBanner from "../components/ContactBanner.astro";
import WindowBar from "../components/WindowBar.astro";
import { SITE_TITLE } from "../consts";
import {
  ABOUT,
  sideProjects,
  socialLinks,
  techStacks,
} from "../data/profile";
import {
  engineeringExperiences,
  groupExperiencesByCompany,
  teachingExperiences,
} from "../data/experience";

const manjaroPostSlug = "how-i-setup-my-pc-for-programming-use";
const companyGroups = groupExperiencesByCompany(engineeringExperiences);
const recentRoles = companyGroups.slice(0, 4).flatMap((group) => group.roles);
const olderRoles = companyGroups.slice(4).flatMap((group) => group.roles);
---

<SiteLayout
  title={`About Alfatta Rezqa | ${SITE_TITLE}`}
  description={ABOUT.description}
>
  <main id="main" class="site-width page-main">
    <header class="page-heading" data-reveal>
      <h1>
        Hi, I'm Alfatta Rezqa<span aria-hidden="true">.</span>
      </h1>
      <p>{ABOUT.description}</p>
    </header>
    <div class="about-grid">
      <section class="window" aria-labelledby="experience-title" data-reveal>
        <WindowBar>
          <h2 id="experience-title">Work experience</h2>
          <span slot="trailing">experience.log</span>
        </WindowBar>
        <div class="window-content">
          <ExperienceTimeline experiences={recentRoles} />
          {olderRoles.length > 0 && (
            <details class="older-roles">
              <summary>Earlier roles ({olderRoles.length})</summary>
              <ExperienceTimeline experiences={olderRoles} />
            </details>
          )}
          <a
            class="text-link experience-source"
            href="https://www.linkedin.com/in/alfattarezqa/details/experience/"
            target="_blank"
            rel="noreferrer"
            data-track-event="experience_link_click"
            data-track-location="work-experience"
            data-track-id="linkedin-experience"
          >
            View on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <div class="about-sidebar">
        <section class="window" aria-labelledby="stack-title" data-reveal>
          <WindowBar>
            <h2 id="stack-title">The toolkit</h2>
            <span slot="trailing">stack.config</span>
          </WindowBar>
          <div class="window-content">
            <PixelIcon class="about-stack-art" name="chip" />
            <div class="stack-list">
              {techStacks.map((tech) => (
                <span>{tech}</span>
              ))}
            </div>
            <a
              class="text-link toolkit-note"
              href={`/blog/${manjaroPostSlug}/`}
              data-track-event="post_click"
              data-track-location="about-toolkit"
              data-track-id={`post-${manjaroPostSlug}`}
              data-track-post-slug={manjaroPostSlug}
            >
              My Manjaro Xfce setup for development <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>
        <section class="window" aria-labelledby="teaching-title" data-reveal>
          <WindowBar>
            <h2 id="teaching-title">Teaching & mentoring</h2>
            <span slot="trailing">share.log</span>
          </WindowBar>
          <div class="window-content">
            <ExperienceTimeline experiences={teachingExperiences} />
          </div>
        </section>
      </div>
    </div>
    <section class="section" aria-labelledby="projects-title">
      <div class="section-title" data-reveal>
        <div>
          <h2 id="projects-title">On my workbench</h2>
        </div>
      </div>
      {sideProjects.map((project) =>
        project.id === "pixrelay" ? (
          <ProjectCard project={project}>
            <PixRelayVisual slot="visual" />
          </ProjectCard>
        ) : (
          <ProjectCard project={project} />
        ),
      )}
    </section>
    <section class="section" aria-labelledby="elsewhere-title">
      <div class="section-title" data-reveal>
        <div>
          <h2 id="elsewhere-title">Let's stay connected</h2>
        </div>
      </div>
      <div class="hero-actions" data-track-location="about-social">
        {socialLinks.map((contact) => (
          <a
            class="button"
            href={contact.href}
            target="_blank"
            rel="noreferrer"
            data-track-event="social_click"
            data-track-id={contact.id}
            data-track-platform={contact.id}
          >
            {contact.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <ContactBanner />
  </main>
</SiteLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    align-items: start;
    gap: 18px;
  }
  .about-sidebar {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .experience-source {
    margin-top: 18px;
  }
  .older-roles {
    margin-top: 25px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
  }
  .older-roles summary {
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stack-list span {
    padding: 5px 8px;
    border: 1px solid var(--line);
    background: var(--blue);
    font-size: 12px;
  }
  .toolkit-note {
    margin-top: 16px;
  }
  .about-stack-art {
    width: 95px;
    height: 95px;
    display: block;
    margin: 0 auto 16px;
  }
  @media (max-width: 600px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
