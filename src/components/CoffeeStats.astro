---
interface Props {
  items: { label: string; value: string | number }[];
}

const { items } = Astro.props;
---

<dl class="coffee-stats">
  {items.map(({ label, value }) => (
    <div>
      <dt class="eyebrow">{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>

<style>
  .coffee-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }
  .coffee-stats div {
    padding: 10px 12px;
    border: 1px solid var(--line);
    background: var(--blue);
  }
  .coffee-stats dt {
    font-size: 9px;
    letter-spacing: 0.7px;
  }
  .coffee-stats dd {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
  }
</style>
