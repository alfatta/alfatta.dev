---
import Workstation from "../Workstation.astro";

interface Props {
  company?: string;
}

const { company } = Astro.props;
---

<section class="hero" aria-labelledby="intro-title" data-track-location="hero">
  <div>
    <p class="eyebrow" data-hero-copy>
      <span class="status-dot"></span> Hello, world. I'm Alfatta Rezqa.
    </p>
    <h1 id="intro-title">
      <span class="hero-line"><span data-hero-line>BUILDING</span></span>{" "}
      <span class="hero-line"><span data-hero-line>THINGS FOR</span></span>{" "}
      <span class="hero-line"><span data-hero-line>THE WEB.</span></span>
    </h1>
    <p class="hero-intro" data-hero-copy>
      A frontend-focused software developer, full-stack when the work needs it.
      <br />Now building a desktop trading app in React, Tauri and Rust.
    </p>
    <div class="hero-actions" data-hero-copy>
      <a class="button primary" href="/contact/" data-track-event="cta_click" data-track-id="hero-contact">
        Get in touch <span aria-hidden="true">→</span>
      </a>
      <a class="button" href="#work" data-track-event="cta_click" data-track-id="explore-work">
        Explore my work <span aria-hidden="true">↘</span>
      </a>
    </div>
    <p class="hero-note" data-hero-copy>
      <span class="pixel-heart" aria-hidden="true">
        ♥
      </span>{" "}
      8+ years of building, learning & shipping{company ? ` · now at ${company}` : ""}.
    </p>
  </div>
  <Workstation />
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.06fr 1fr;
    align-items: center;
    gap: 22px;
    padding-block: 36px 28px;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--blue);
    flex: none;
  }
  .hero h1 {
    font-size: clamp(48px, 7.4vw, 96px);
    line-height: 0.9;
    letter-spacing: 0.01em;
    margin: 18px 0;
  }
  .hero-line {
    display: block;
    overflow: clip;
    padding-block: 0.08em;
    margin-block: -0.08em;
  }
  .hero-line > span {
    display: block;
    transform-origin: left bottom;
  }
  .hero-line:last-child {
    color: var(--accent);
  }
  .hero-intro {
    max-width: 420px;
    font-size: 13px;
    line-height: 1.75;
  }
  .hero-intro strong {
    color: var(--accent);
  }
  .hero-note {
    margin-top: 18px;
    color: var(--muted);
    font-size: 11px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .pixel-heart {
    font-size: 17px;
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .hero {
      gap: 0;
    }
    .hero-intro {
      font-size: 12px;
    }
  }
  @media (max-width: 600px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 24px 20px;
      gap: 18px;
    }
    .hero h1 {
      font-size: clamp(62px, 18vw, 80px);
      margin: 16px 0;
    }
    .hero-intro {
      max-width: 350px;
    }
    .hero-note {
      margin-top: 16px;
    }
  }
</style>
