---
import WindowBar from "../WindowBar.astro";
import CoffeeHeatmap from "../CoffeeHeatmap.astro";
import CoffeeStats from "../CoffeeStats.astro";
import CoffeePhoto from "../CoffeePhoto.astro";
import PixelIcon from "../PixelIcon.astro";
import { buildHeatmap, formatCupDay, type CoffeeSummary } from "../../data/coffee";
import { COFFEE_START } from "../../data/coffee-log";

interface Props {
  summary: CoffeeSummary;
}

const { summary } = Astro.props;
const weeks = buildHeatmap(summary, 18, 18);
const { latest } = summary;
const startLabel = new Date(`${COFFEE_START}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  timeZone: "UTC",
});
const stats = [
  { label: "Today", value: summary.todayCount },
  { label: "Last 7 days", value: summary.last7 },
  { label: "Streak", value: `${summary.streak}d` },
  { label: "Total", value: summary.total },
];
---

<section class="section" aria-labelledby="coffee-title" data-track-location="coffee-preview">
  <div class="section-title" data-reveal>
    <div>
      <h2 id="coffee-title">Coffee</h2>
    </div>
    <a class="text-link" href="/coffee/" data-track-event="cta_click" data-track-id="coffee-log">
      Full log <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="window" data-reveal>
    <WindowBar>
      <span>▤ &nbsp; coffee.log</span>
      <span slot="trailing">{summary.total} CUPS</span>
    </WindowBar>
    <div class="window-content coffee-preview">
      <div class="coffee-preview-main">
        {latest ? (
          <>
            <p class="eyebrow">Latest cup</p>
            <div class="latest-row">
              <CoffeePhoto cup={latest} size={72} />
              <p class="latest">
                <strong>{latest.drink}</strong>
                <span>{formatCupDay(latest.date, summary.today)} {latest.time} · {latest.place}{latest.venue && ` · ${latest.venue}`}</span>
              </p>
            </div>
            <CoffeeStats items={stats} />
          </>
        ) : (
          <div class="latest-row">
            <PixelIcon name="cup" class="coffee-preview-icon" />
            <p class="latest">
              <strong>No cups logged yet.</strong>
              <span>The log opens on {startLabel}: one line per cup, with the time and the place.</span>
            </p>
          </div>
        )}
      </div>
      <CoffeeHeatmap
        weeks={weeks}
        label={`Heatmap of the last 18 weeks of coffee: ${summary.total} cups in total.`}
      />
    </div>
  </div>
</section>

<style>
  .coffee-preview {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  .coffee-preview-main {
    display: grid;
    gap: 14px;
  }
  .latest-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .latest {
    display: grid;
    gap: 2px;
  }
  .latest strong {
    font-size: 16px;
  }
  .latest span {
    color: var(--muted);
  }
  .coffee-preview-icon {
    width: 56px;
    height: 56px;
    flex: none;
  }
  .latest span {
    max-width: 46ch;
  }
  @media (max-width: 700px) {
    .coffee-preview {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
