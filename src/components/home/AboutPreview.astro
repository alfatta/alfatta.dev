---
import { techStacks } from "../../data/profile";
---

<section class="section about-preview" aria-labelledby="approach-title" data-track-location="about-preview">
  <div data-reveal>
    <h2 id="approach-title">What I work with</h2>
    <p>
      Frontend is my focus. I also build the APIs behind it and the tools
      around it, and I have taught Vue, React and Express to students.
    </p>
    <a class="text-link" href="/about/" data-track-event="cta_click" data-track-id="more-about-me">
      More about me <span aria-hidden="true">→</span>
    </a>
  </div>
  <ul class="stack-list" aria-label="Technologies" data-reveal>
    {techStacks.map((tech) => <li>{tech}</li>)}
  </ul>
</section>

<style>
  .about-preview {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px;
    align-items: start;
  }
  .about-preview h2 {
    font-size: 42px;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .about-preview p {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 14px;
    max-width: 440px;
  }
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack-list li {
    padding: 5px 10px;
    border: 1px solid var(--line);
    background: var(--blue);
    font-size: 12px;
  }
  @media (max-width: 900px) {
    .about-preview {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
  @media (max-width: 600px) {
    .about-preview h2 {
      font-size: 36px;
    }
  }
</style>
