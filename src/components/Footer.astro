---
import { contactLinks } from "../data/profile";
---

<footer class="site-width site-footer">
  <p>
    © {new Date().getFullYear()} Alfatta Rezqa. Built with care & a little
    nostalgia.
  </p>
  <div class="footer-links">
    <a href="/contact/">Contact</a>
    {contactLinks
      .filter((contact) => ["linkedin", "x", "email"].includes(contact.id))
      .map((contact) => (
        <a
          href={contact.href}
          target={contact.kind === "social" ? "_blank" : undefined}
          rel="noreferrer"
        >
          {contact.label} ↗
        </a>
      ))}
    <a href="/rss.xml">RSS ↗</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 18px 24px;
    font-size: 9px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .site-footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
