---
import { socialLinks } from "../data/profile";
---

<footer class="site-width site-footer" data-track-location="footer">
  <p>
    © {new Date().getFullYear()} Alfatta Rezqa. Built with care & a little
    nostalgia.
  </p>
  <div class="footer-links">
    <a href="/contact/" data-track-event="navigation_click" data-track-id="contact">Contact</a>
    {socialLinks
      .filter((contact) => contact.id === "linkedin" || contact.id === "x")
      .map((contact) => (
        <a
          href={contact.href}
          data-track-event="social_click"
          data-track-id={contact.id}
          data-track-platform={contact.id}
          target="_blank"
          rel="noreferrer"
        >
          {contact.label} ↗
        </a>
      ))}
    <a href="/rss.xml" data-track-event="rss_click" data-track-id="rss">RSS ↗</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 18px 24px;
    font-size: 11px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    text-decoration: none;
    position: relative;
  }
  .footer-links a::before {
    content: "";
    position: absolute;
    inset: -14px -6px;
  }
  @media (max-width: 600px) {
    .site-footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
