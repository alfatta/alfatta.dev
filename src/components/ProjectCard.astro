---
import type { Project } from "../data/profile";
import WindowBar from "./WindowBar.astro";
interface Props {
  project: Project;
}
const { project } = Astro.props;
const hasVisual = Boolean(project.image) || Astro.slots.has("visual");
---

<article class="window" data-reveal data-track-location="project">
  <WindowBar>
    <span>▧ &nbsp; {project.windowTitle}</span>
  </WindowBar>
  <div
    class:list={["project-body", { "project-body--with-visual": hasVisual }]}
  >
    {hasVisual && (
      <div
        class:list={[
          "project-visual",
          { "project-visual-image": project.image },
        ]}
        data-depth
      >
        <div class="project-art-track" data-scroll-art>
          {project.image ? (
            <img
              src={project.image.src}
              alt={project.image.alt}
              width={project.image.width}
              height={project.image.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <slot name="visual" />
          )}
        </div>
      </div>
    )}
    <div class="project-copy">
      <span class="eyebrow">{project.eyebrow}</span>
      <h3>{project.name}</h3>
      <p>{project.description}</p>
      <div class="tags">
        {project.technologies.map((technology) => (
          <span class="tag">{technology.toUpperCase()}</span>
        ))}
      </div>
      <div class="project-links">
        {project.links.map((link) => (
          <a
            class="text-link"
            href={link.href}
            data-track-event="project_link_click"
            data-track-id={`${project.id}:${link.label}`}
            data-track-project-id={project.id}
            target="_blank"
            rel="noreferrer"
          >
            {link.label} ↗
          </a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .project-body--with-visual {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
  .project-visual {
    min-width: 0;
    min-height: 275px;
    background-color: var(--blue);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 18px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    overflow: clip;
    border-right: 1px solid var(--line);
  }
  .project-art-track {
    width: 100%;
  }
  .project-visual-image {
    padding: 15px;
  }
  .project-visual-image .project-art-track {
    max-width: 420px;
  }
  .project-visual-image img {
    width: 100%;
    aspect-ratio: 1.5;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .project-copy {
    padding: 24px;
    min-width: 0;
    align-self: center;
  }
  .project-copy h3 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.01em;
    font-size: 46px;
    margin: 8px 0 12px;
  }
  .project-copy p {
    font-size: 12px;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 16px 0;
  }
  .tag {
    border: 1px solid var(--line);
    background: var(--blue);
    padding: 1px 7px;
    font-size: 9px;
  }
  .project-links {
    display: flex;
    gap: 24px;
  }
  @media (max-width: 900px) {
    .project-copy {
      padding: 20px;
    }
  }
  @media (max-width: 600px) {
    .project-body--with-visual {
      grid-template-columns: minmax(0, 1fr);
    }
    .project-visual {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      min-height: 210px;
    }
  }
</style>
