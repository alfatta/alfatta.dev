---
import PixelIcon from "./PixelIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
const pathname = Astro.url.pathname;
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <nav class="site-width nav" aria-label="Main navigation">
    <a class="brand" href="/">
      <PixelIcon name="monitor" class="brand-icon" />
      <span>
        alfatta.rezqa<small>SOFTWARE DEVELOPER</small>
      </span>
    </a>
    <div class="nav-links">
      {[
        ["/", "Home"],
        ["/blog/", "Blog"],
        ["/about/", "About"],
        ["/contact/", "Contact"],
      ].map(([href, label]) => (
        <a
          class="nav-link"
          href={href}
          aria-current={
            (href === "/" ? pathname === "/" : pathname.startsWith(href))
              ? "page"
              : undefined
          }
        >
          {label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: relative;
    z-index: 10;
  }
  .nav {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.6px;
  }
  .brand small {
    display: block;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 1.5px;
    color: var(--muted);
  }
  .brand-icon {
    width: 34px;
    height: 34px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .nav-link {
    text-decoration: none;
    font-size: 12px;
    padding: 8px 0;
    border-bottom: 2px solid transparent;
    position: relative;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 -2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease-out;
  }
  .nav-link[aria-current="page"] {
    font-weight: 700;
  }
  .nav-link:is(:hover, :focus-visible) {
    color: var(--accent);
  }
  .nav-link[aria-current="page"]::after,
  .nav-link:is(:hover, :focus-visible)::after {
    transform: scaleX(1);
  }
  .skip-link {
    position: fixed;
    top: -100px;
    left: 15px;
    padding: 12px;
    background: var(--surface);
    z-index: 100;
  }
  .skip-link:focus {
    top: 10px;
  }
  @media (max-width: 600px) {
    .nav {
      min-height: 90px;
      flex-wrap: wrap;
      gap: 8px;
      padding-block: 15px;
    }
    .brand {
      font-size: 13px;
      gap: 8px;
    }
    .brand small {
      font-size: 8px;
    }
    .brand-icon {
      width: 28px;
      height: 28px;
    }
    .nav-links {
      gap: 17px;
    }
    .nav-link {
      font-size: 10px;
    }
  }
  @media (max-width: 370px) {
    .nav-links {
      gap: 12px;
    }
    .brand small {
      display: none;
    }
    .brand {
      font-size: 12px;
    }
  }
</style>
