---
import type { HeatCell } from "../data/coffee";

interface Props {
  weeks: HeatCell[][];
  /** Accessible summary; the cells themselves are decorative. */
  label: string;
}

const { weeks, label } = Astro.props;
---

<figure class="heatmap" role="img" aria-label={label}>
  <div class="heatmap-body" style={`--weeks: ${weeks.length}`} aria-hidden="true">
    <ol class="heatmap-days">
      {["S", "M", "T", "W", "T", "F", "S"].map((day) => <li>{day}</li>)}
    </ol>
    <div class="heatmap-grid">
      {weeks.map((week, index) => (
        <div class="heatmap-week">
          {week.map((cell) => (
            <span
              class="heat-cell"
              data-level={cell.level}
              data-state={cell.state}
              data-label={cell.state === "before" ? undefined : cell.label}
              data-align={index < 3 ? "start" : index >= weeks.length - 3 ? "end" : undefined}
            ></span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <figcaption class="heatmap-legend" aria-hidden="true">
    Less
    {[0, 1, 2, 3].map((level) => <span class="heat-cell" data-level={level} data-state="past"></span>)}
    More
  </figcaption>
</figure>

<style>
  .heatmap {
    margin: 0;
  }
  .heatmap-body {
    display: flex;
    gap: 8px;
    width: min(100%, calc(var(--weeks) * 30px + 22px));
  }
  .heatmap-days {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    color: var(--muted);
  }
  .heatmap-days li {
    display: grid;
    align-items: center;
  }
  .heatmap-grid {
    display: grid;
    flex: 1;
    min-width: 0;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    gap: 4px;
  }
  .heatmap-week {
    display: grid;
    grid-template-rows: repeat(7, auto);
    gap: 4px;
  }
  .heat-cell {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .heat-cell[data-label]:hover {
    z-index: 2;
    border-color: var(--ink);
  }
  .heat-cell[data-label]:hover::after {
    content: attr(data-label);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    translate: -50% 0;
    padding: 3px 8px;
    border: 1px solid var(--ink);
    background: var(--surface);
    box-shadow: 2px 2px 0 var(--shadow);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
  }
  .heat-cell[data-align="start"]:hover::after {
    left: 0;
    translate: 0;
  }
  .heat-cell[data-align="end"]:hover::after {
    left: auto;
    right: 0;
    translate: 0;
  }
  .heat-cell[data-level="1"] {
    background: color-mix(in srgb, var(--accent) 35%, var(--paper));
  }
  .heat-cell[data-level="2"] {
    background: color-mix(in srgb, var(--accent) 65%, var(--paper));
  }
  .heat-cell[data-level="3"] {
    background: var(--accent);
  }
  .heat-cell[data-state="future"] {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--line) 50%, transparent);
    background: transparent;
  }
  .heat-cell[data-state="before"] {
    visibility: hidden;
  }
  .heat-cell[data-state="today"] {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 14px;
    font-size: 10px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .heatmap-legend .heat-cell {
    width: 14px;
  }
  .heatmap-legend .heat-cell:first-of-type {
    margin-left: 4px;
  }
  .heatmap-legend .heat-cell:last-of-type {
    margin-right: 4px;
  }
</style>
