---
import { getImage } from "astro:assets";
import type { CoffeeCup } from "../data/coffee-log";

interface Props {
  cup: CoffeeCup;
  /** Square thumbnail edge in CSS px. */
  size?: number;
}

const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/coffee/*.{jpg,jpeg,png,webp}", { eager: true });

const { cup, size = 44 } = Astro.props;
const source = photos[`../assets/coffee/${cup.photo}`]?.default;
if (cup.photo && !source) throw new Error(`Coffee photo not found in src/assets/coffee: ${cup.photo}`);

const alt = `${cup.drink} at ${cup.venue ?? cup.place}`;
const thumb = source && (await getImage({ src: source, width: size * 2, height: size * 2, fit: "cover", format: "webp" }));
const full = source && (await getImage({ src: source, width: 960, format: "webp" }));
---

{thumb && full && (
  <a
    class="cup-photo"
    href={full.src}
    style={`--size: ${size}px`}
    data-lightbox
    data-alt={alt}
    data-track-event="cta_click"
    data-track-id="coffee-photo"
  >
    <img src={thumb.src} width={size} height={size} alt={alt} loading="lazy" decoding="async" />
  </a>
)}

<style>
  .cup-photo {
    display: block;
    width: var(--size);
    height: var(--size);
    border: 1px solid var(--line);
    box-shadow: 2px 2px 0 var(--shadow);
    line-height: 0;
  }
  .cup-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cup-photo:is(:hover, :focus-visible) {
    border-color: var(--accent);
  }
</style>
