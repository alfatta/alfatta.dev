---
import PixelIcon from "./PixelIcon.astro";
---

<section class="contact-banner" aria-label="Get in touch" data-reveal data-track-location="contact-banner">
  <PixelIcon name="mail" />
  <div>
    <h2>Hiring, or have a project?</h2>
    <p>Or a question about something I wrote. Write to me.</p>
  </div>
  <a class="button primary" href="/contact/" data-track-event="cta_click" data-track-id="say-hello">
    Contact me <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .contact-banner {
    margin-block: 40px 28px;
    background: var(--blue);
    border: 1px solid var(--line);
    box-shadow: 4px 4px 0 var(--shadow);
    padding: 22px 26px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .contact-banner > :global(svg) {
    width: 70px;
    height: 70px;
    flex: none;
  }
  .contact-banner h2 {
    font-size: 38px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .contact-banner p {
    font-size: 12px;
  }
  .contact-banner .button {
    margin-left: auto;
    flex: none;
  }
  @media (max-width: 900px) {
    .contact-banner {
      padding: 20px;
      gap: 16px;
    }
    .contact-banner > :global(svg) {
      display: none;
    }
    .contact-banner h2 {
      font-size: 34px;
    }
  }
  @media (max-width: 600px) {
    .contact-banner {
      flex-wrap: wrap;
      padding: 18px;
      margin-top: 30px;
    }
    .contact-banner .button {
      margin-left: 0;
    }
  }
</style>
